---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import headshot from '../assets/headshot.jpg';
import speaking from '../assets/speaking.jpg';
import makingTheCase from '../assets/making-the-case.jpg';
import gathering from '../assets/gathering.jpg';

const ACTBLUE = 'https://secure.actblue.com/donate/jim-bednar-1';
const EMAIL = 'bednar4sullivannh@gmail.com';
const CURRENT_SITE = 'https://bednar4nh.com/';
const COUNTY_DEMS = 'https://vote.sullivancountynhdems.org/jim-bednar';

// The four pillar headings are word-for-word from the campaign flyer and business card;
// the blurbs draw on the biography Jim supplied.
const pillars = [
  {
    title: 'Responsible stewardship of your tax dollars',
    blurb:
      'Jim spent a career answerable for public money — program budgets funded by American taxpayers, audited and justified line by line. The county portion of your tax bill deserves the same scrutiny.',
  },
  {
    title: 'Proven leadership and practical experience',
    blurb:
      'Nearly forty years with USAID heading programs across Africa, Asia, the Middle East and post-Communist Czechoslovakia. Budgets, staff, and hard decisions in places where getting it wrong had consequences.',
  },
  {
    title: 'Long-term roots in Sullivan County',
    blurb:
      'The Bednars came to Springfield seventy years ago. Jim raised three children on summers and holidays here, and has served the town from the zoning board to the Historical Society since retiring home.',
  },
  {
    title: 'Working together for a stronger community',
    blurb:
      'Ten years leading the Springfield Historical Society turned a quiet museum into a place the town actually gathers — including a traditional barn raising to house Springfield’s agricultural heritage.',
  },
];

// Photos from a campaign gathering, supplied by the campaign in September 2026.
const photos = [
  {
    src: speaking,
    alt: 'Jim Bednar standing with notes in hand, speaking to a seated group in a sunlit room',
    caption: 'Making the case to a room of neighbors',
  },
  {
    src: makingTheCase,
    alt: 'Jim Bednar gesturing while speaking, standing behind a table set with food, guests listening',
    caption: 'Taking questions over the potluck table',
  },
  {
    src: gathering,
    alt: 'A living room full of seated guests listening during a campaign gathering',
    caption: 'A full room, on a Sunday afternoon',
  },
];

// Each topic is fetched on demand by htmx from /public/partials/.
const topics = [
  { id: 'commission', label: 'What commissioners do' },
  { id: 'nursing-home', label: 'Sullivan County Health Care' },
  { id: 'services', label: 'The rest of the county' },
  { id: 'budget', label: 'Where the money comes from' },
];

const navLinks = [
  { href: '#about', label: 'About Jim' },
  { href: '#priorities', label: 'Priorities' },
  { href: '#trail', label: 'On the Trail' },
  { href: '#county', label: 'County 101' },
  { href: '#contact', label: 'Contact' },
];
---

<Layout
  title="Jim Bednar for Sullivan County Commissioner | New Hampshire"
  description="Jim Bednar is the Democratic candidate for Sullivan County Commissioner — nearly forty years with USAID, seventy years of family roots in Springfield. Fresh thinking by an experienced manager."
>
  <!-- ===== Nav ===== -->
  <header x-data="{ open: false }" class="sticky top-0 z-50 bg-white shadow-sm">
    <div class="h-1.5 bg-navy"><div class="h-full w-1/3 bg-flag-red"></div></div>

    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href="#top" class="flex items-baseline gap-2">
        <span class="text-flag-red" aria-hidden="true">&#9733;</span>
        <span class="font-display text-xl font-extrabold uppercase tracking-tight text-navy"
          >Jim Bednar</span
        >
        <span class="hidden text-sm italic text-slate-500 xl:inline"
          >for Sullivan County Commissioner</span
        >
      </a>

      <div class="hidden items-center gap-5 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="whitespace-nowrap font-display text-sm font-semibold uppercase tracking-wide text-navy transition hover:text-flag-red"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={ACTBLUE}
          target="_blank"
          rel="noopener"
          class="rounded bg-flag-red px-4 py-2 font-display text-sm font-bold uppercase tracking-wider text-white transition hover:bg-flag-bright"
          >Contribute</a
        >
      </div>

      <button
        class="rounded p-1 text-navy lg:hidden"
        @click="open = !open"
        :aria-expanded="open"
        aria-label="Toggle menu"
      >
        <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path x-show="!open" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
          <path x-show="open" x-cloak stroke-linecap="round" d="M6 6l12 12M6 18L18 6"></path>
        </svg>
      </button>
    </nav>

    <div x-show="open" x-cloak @click="open = false" class="border-t border-navy-pale lg:hidden">
      <div class="flex flex-col gap-1 px-4 py-3">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="py-2 font-display text-sm font-semibold uppercase tracking-wide text-navy"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={ACTBLUE}
          target="_blank"
          rel="noopener"
          class="mt-2 rounded bg-flag-red px-4 py-2 text-center font-display font-bold uppercase tracking-wider text-white"
          >Contribute on ActBlue</a
        >
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ===== Hero (yard sign, on white) ===== -->
    <section id="top" class="bg-white">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 md:grid-cols-5 md:py-20">
        <div class="md:col-span-3">
          <div class="flex gap-3 text-2xl text-flag-red" aria-hidden="true">
            <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
          </div>

          <h1
            class="mt-4 font-display text-6xl font-black uppercase leading-[0.92] tracking-tighter text-navy sm:text-7xl lg:text-8xl"
          >
            Jim<br />Bednar
          </h1>

          <div class="mt-6 inline-flex items-center gap-3 bg-flag-red px-5 py-3">
            <span class="text-white" aria-hidden="true">&#9733;</span>
            <p
              class="font-display text-base font-bold uppercase leading-tight tracking-wide text-white sm:text-lg"
            >
              Sullivan County Commissioner
            </p>
            <span class="text-white" aria-hidden="true">&#9733;</span>
          </div>

          <p
            class="mt-4 font-display text-lg font-bold uppercase tracking-[0.12em] text-navy sm:text-xl sm:tracking-[0.2em]"
          >
            Sullivan County &middot; New Hampshire
          </p>

          <p class="mt-3 text-base text-slate-600">
            Every voter in Sullivan County votes on this seat.
          </p>

          <p class="mt-6 max-w-lg text-xl italic leading-relaxed text-slate-700">
            &ldquo;Fresh thinking by an experienced manager.&rdquo;
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={ACTBLUE}
              target="_blank"
              rel="noopener"
              class="rounded bg-flag-red px-8 py-3 text-center font-display text-lg font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-flag-bright"
              >Contribute</a
            >
            <a
              href="#about"
              class="rounded border-2 border-navy px-8 py-3 text-center font-display text-lg font-bold uppercase tracking-wider text-navy transition hover:bg-navy hover:text-white"
              >Meet Jim</a
            >
          </div>
        </div>

        <div class="md:col-span-2">
          <div class="mx-auto max-w-xs md:max-w-sm">
            <div class="relative">
              <div
                class="absolute -bottom-3 -right-3 h-full w-full bg-navy-pale"
                aria-hidden="true"
              >
              </div>
              <Image
                src={headshot}
                alt="Jim Bednar, smiling outdoors in a checked shirt in front of a green hedge"
                class="relative aspect-[4/5] w-full border-4 border-navy object-cover object-center shadow-xl"
                widths={[400, 773]}
                sizes="(min-width: 768px) 24rem, 18rem"
                loading="eager"
              />
            </div>
            <p class="mt-7 text-center text-sm italic text-slate-500">
              Jim Bednar, Democratic candidate for Sullivan County Commissioner
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section id="about" class="scroll-mt-24 border-y-4 border-navy bg-navy-pale/40">
      <div class="mx-auto max-w-4xl px-4 py-16 md:py-20">
        <p class="font-display text-sm font-bold uppercase tracking-[0.25em] text-flag-red">
          Meet Jim
        </p>
        <h2
          class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight text-navy sm:text-5xl"
        >
          Seventy years of Springfield,<br class="hidden sm:inline" /> forty years of service
        </h2>

        <div class="mt-8 space-y-5 text-lg leading-relaxed">
          <p>
            Jim Bednar&rsquo;s family came to Springfield, New Hampshire seventy years ago.
            After retiring from the ministry, Jim&rsquo;s father moved here with his wife
            &mdash; able to rest, but still serving communities, preaching in Claremont,
            Keene and Wilmot. That sense of service was instilled in Jim.
          </p>
          <p>
            He served his country for close to forty years with <strong>USAID</strong>,
            heading programs throughout Africa, Asia, the Middle East, and in post-Communist
            Czechoslovakia. Throughout all of it, Springfield was home &mdash; where Jim, his
            wife and their three children spent summers and holidays.
          </p>
          <p>
            Across that career and the retirements that followed, the commitment stayed the
            same: support and strengthen communities. Small farmers in Africa. Small
            businesses in Czechoslovakia. Helping communities in Sri Lanka recover and
            rebuild after their civil war.
          </p>
          <p>
            Retiring full time to Springfield did not change the pattern. Jim has served on
            the town <strong>zoning board</strong> and the <strong>Springfield 250th
            Celebration committee</strong>, and for the last ten years has headed the
            <strong>Springfield Historical Society</strong>. Under his leadership the
            Historical Society Museum was transformed into a place where the community
            gathers and takes part &mdash; and a traditional barn raising built a barn to
            display Springfield&rsquo;s agricultural heritage. He also chairs
            <strong>Springfield&rsquo;s Democratic Committee</strong>, building a community
            of like-minded neighbors to support candidates and policies that benefit the
            town.
          </p>
          <p>
            Jim will bring that same commitment to supporting communities to the job of
            County Commissioner.
          </p>
        </div>

        <!-- At-a-glance figures, all drawn from the biography above. -->
        <dl class="mt-10 grid gap-4 sm:grid-cols-3">
          {
            [
              { n: '70', unit: 'years', label: 'of Bednars in Springfield' },
              { n: '40', unit: 'years', label: 'with USAID, on four continents' },
              { n: '10', unit: 'years', label: 'heading the Historical Society' },
            ].map((stat) => (
              <div class="border-t-4 border-flag-red bg-white p-5 shadow-sm">
                <dt class="flex items-baseline gap-2">
                  <span class="font-display text-4xl font-black leading-none text-navy">
                    {stat.n}
                  </span>
                  <span class="font-display text-sm font-bold uppercase tracking-widest text-flag-red">
                    {stat.unit}
                  </span>
                </dt>
                <dd class="mt-2 leading-snug text-slate-700">{stat.label}</dd>
              </div>
            ))
          }
        </dl>

        <blockquote class="mt-10 border-l-4 border-flag-red bg-white p-6 shadow-sm">
          <p class="text-xl italic leading-relaxed text-navy-dark">
            When Jim becomes Commissioner, it will be the fourth time he has come out of
            retirement to serve.
          </p>
          <footer
            class="mt-4 font-display text-sm font-bold uppercase tracking-widest text-flag-red"
          >
            &mdash; Friends of Jim Bednar
          </footer>
        </blockquote>
      </div>
    </section>

    <!-- ===== Priorities ===== -->
    <section id="priorities" class="scroll-mt-24 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
        <div class="max-w-2xl">
          <p class="font-display text-sm font-bold uppercase tracking-[0.25em] text-flag-red">
            What Jim Stands For
          </p>
          <h2
            class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight text-navy sm:text-5xl"
          >
            Four commitments
          </h2>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            pillars.map((pillar, i) => (
              <div class="flex gap-5 border-t-4 border-navy bg-white p-6 shadow-md transition hover:-translate-y-1 hover:shadow-lg">
                <span
                  class="font-display text-4xl font-black leading-none text-navy-pale"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-lg font-extrabold uppercase leading-snug tracking-wide text-navy">
                    {pillar.title}
                  </h3>
                  <p class="mt-2 leading-relaxed text-slate-700">{pillar.blurb}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== On the trail (photos) ===== -->
    <section id="trail" class="scroll-mt-24 bg-navy text-white">
      <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
        <div class="max-w-2xl">
          <p class="font-display text-sm font-bold uppercase tracking-[0.25em] text-white/70">
            Out in the County
          </p>
          <h2 class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">
            On the trail
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-navy-pale">
            Sullivan County is fifteen communities spread across 528 square miles, and all of
            them vote on this seat. Jim is spending the campaign the way county races are won
            &mdash; in living rooms, around kitchen tables, answering questions one at a time.
          </p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          {
            photos.map((photo) => (
              <figure>
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  class="aspect-[4/3] w-full border-4 border-white/15 object-cover shadow-lg"
                  widths={[360, 640]}
                  sizes="(min-width: 640px) 22rem, 100vw"
                  loading="lazy"
                />
                <figcaption class="mt-3 text-sm italic text-navy-pale/90">
                  {photo.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="mt-10 flex gap-4 text-2xl text-white/40" aria-hidden="true">
          <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
        </div>
      </div>
    </section>

    <!-- ===== County 101 (htmx-loaded fragments) ===== -->
    <section id="county" class="scroll-mt-24 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-16 md:py-20">
        <div class="max-w-2xl">
          <p class="font-display text-sm font-bold uppercase tracking-[0.25em] text-flag-red">
            County Government 101
          </p>
          <h2
            class="mt-3 font-display text-4xl font-extrabold uppercase tracking-tight text-navy sm:text-5xl"
          >
            The most overlooked race on the ballot
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-700">
            Most voters can name their state rep and their selectboard. Almost nobody can name
            a county commissioner &mdash; even though the county spends millions of your
            property tax dollars every year. Here is what the job actually covers.
          </p>
        </div>

        <div x-data="{ active: 'commission' }" class="mt-10 grid gap-8 md:grid-cols-[16rem_1fr]">
          <div class="flex flex-col gap-2">
            {
              topics.map((topic) => (
                <button
                  type="button"
                  hx-get={`/partials/${topic.id}.html`}
                  hx-target="#county-answer"
                  hx-swap="innerHTML"
                  hx-indicator="#county-loading"
                  x-on:click={`active = '${topic.id}'`}
                  x-bind:class={`active === '${topic.id}' ? 'border-flag-red bg-flag-pale text-navy' : 'border-navy-pale bg-white text-slate-600 hover:border-navy hover:text-navy'`}
                  class="border-l-4 px-5 py-3 text-left font-display text-sm font-bold uppercase tracking-wide transition"
                >
                  {topic.label}
                </button>
              ))
            }
          </div>

          <div class="relative min-h-[18rem] border-t-4 border-navy bg-navy-pale/30 p-6 sm:p-8">
            <span
              id="county-loading"
              class="htmx-indicator absolute right-6 top-6 font-display text-xs font-bold uppercase tracking-widest text-flag-red"
              >Loading&hellip;</span
            >
            <div
              id="county-answer"
              class="text-lg text-slate-800"
              hx-get="/partials/commission.html"
              hx-trigger="load"
              hx-swap="innerHTML"
              aria-live="polite"
            >
              <p class="italic text-slate-500">Pick a topic to read more.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Contact / Get involved ===== -->
    <section id="contact" class="scroll-mt-24 border-t-4 border-flag-red bg-navy-pale/40">
      <div class="mx-auto max-w-4xl px-4 py-16 text-center md:py-20">
        <div class="flex justify-center gap-4 text-2xl text-flag-red" aria-hidden="true">
          <span>&#9733;</span><span>&#9733;</span><span>&#9733;</span>
        </div>
        <h2
          class="mt-5 font-display text-4xl font-extrabold uppercase tracking-tight text-navy sm:text-5xl"
        >
          Get involved
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-700">
          County races are won on yard signs, kitchen tables, and neighbors talking to
          neighbors. Chip in, ask for a sign, or just email Jim a question about the county
          &mdash; he will answer it.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href={ACTBLUE}
            target="_blank"
            rel="noopener"
            class="rounded bg-flag-red px-10 py-4 text-center font-display text-lg font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-flag-bright"
            >Contribute on ActBlue</a
          >
          <a
            href={`mailto:${EMAIL}`}
            class="rounded border-2 border-navy px-10 py-4 text-center font-display text-lg font-bold uppercase tracking-wider text-navy transition hover:bg-navy hover:text-white"
            >Email Jim</a
          >
        </div>

        <div class="mt-10 grid gap-4 text-left sm:grid-cols-3">
          <div class="border-t-2 border-navy bg-white p-5">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-flag-red">
              Email
            </p>
            <a href={`mailto:${EMAIL}`} class="mt-2 block break-all text-navy hover:underline"
              >{EMAIL}</a
            >
          </div>
          <div class="border-t-2 border-navy bg-white p-5">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-flag-red">
              Campaign site
            </p>
            <a href={CURRENT_SITE} class="mt-2 block break-all text-navy hover:underline"
              >bednar4nh.com</a
            >
          </div>
          <div class="border-t-2 border-navy bg-white p-5">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-flag-red">
              County Democrats
            </p>
            <a
              href={COUNTY_DEMS}
              target="_blank"
              rel="noopener"
              class="mt-2 block break-all text-navy hover:underline">Jim&rsquo;s candidate page</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="bg-navy text-navy-pale">
    <div class="mx-auto max-w-4xl space-y-3 px-4 py-10 text-center text-sm">
      <p class="font-display text-lg font-extrabold uppercase tracking-wide text-white">
        Jim Bednar for Sullivan County Commissioner
      </p>
      <p class="font-display text-xs font-bold uppercase tracking-[0.25em] text-white/70">
        Paid for by the Friends of Jim Bednar
      </p>
      <p>
        <a href={`mailto:${EMAIL}`} class="hover:underline">{EMAIL}</a>
        &nbsp;&bull;&nbsp;
        <a href={ACTBLUE} target="_blank" rel="noopener" class="hover:underline">Contribute</a>
      </p>
      <p class="pt-2 text-xs text-navy-pale/60">
        &copy; {new Date().getFullYear()} Friends of Jim Bednar. All rights reserved.
      </p>
    </div>
  </footer>
</Layout>

<style is:global>
  [x-cloak] {
    display: none !important;
  }

  /* htmx loading indicator */
  .htmx-indicator {
    opacity: 0;
    transition: opacity 150ms ease-in;
  }
  .htmx-request .htmx-indicator,
  .htmx-request.htmx-indicator {
    opacity: 1;
  }
</style>
